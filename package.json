{
  "name": "mochilog-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && wrangler deploy --dry-run --outdir dist",
    "test": "playwright test",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "pnpm typecheck && wrangler deploy",
    "dep": "pnpm run deploy",
    "format": "prettier --write src tests public/styles.css vite.config.ts playwright.config.ts package.json .prettierrc.json",
    "format:check": "prettier --check src tests public/styles.css vite.config.ts playwright.config.ts package.json .prettierrc.json"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "1.65.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.0.0"
  }
}
